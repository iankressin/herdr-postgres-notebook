{
  "name": "herdr-pg-notebook",
  "version": "0.0.0",
  "private": true,
  "description": "A PostgreSQL notebook mod for Herdr",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "check:modules": "node --experimental-vm-modules scripts/check-modules.js",
    "check:host": "node scripts/check-host.js",
    "check": "npm run check:modules && npm test"
  }
}
